@model BL.ViewModels.CompanyDet.CompanyFilterVM

@{
    ViewData["Title"] = "Company Management";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary mb-2">
                <i class="bi bi-building"></i> Company Management Dashboard
            </h2>
            <p class="text-muted">Manage and monitor all company profiles</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/CompanyDet/ViewOAdd" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Company
            </a>
            <a href="/CompanyDet/Export" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Export to Excel
            </a>
        </div>
    </div>

    <!-- Filter and Search Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <!-- Expiry Status Filter -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-funnel"></i> Expiry Status
                    </label>
                    <select id="companyTypeFilter" class="form-select" onchange="applyFilters()">
                        <option value="All">All Companies</option>
                        <option value="Expired">Expired Only</option>
                        <option value="Active">Active Only</option>
                        <option value="ExpiringSoon">Expiring Soon</option>
                    </select>
                </div>

                <!-- Search Box -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-search"></i> Search Companies
                    </label>
                    <input type="text" 
                           id="searchInput" 
                           class="form-control" 
                           placeholder="Type company name to search..." 
                           value="@Model.SearchTerm"
                           oninput="applyFilters()">
                </div>

                <!-- Page Size -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-list-ol"></i> Show
                    </label>
                    <select id="pageSizeFilter" class="form-select" onchange="applyFilters()">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                <!-- Clear Filters -->
                <div class="col-md-1 text-center">
                    <label class="form-label fw-semibold d-block">&nbsp;</label>
                    <a href="#" onclick="clearFilters(); return false;" class="btn btn-link text-primary text-decoration-none fw-semibold" title="Clear all filters">
                        Clear All
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Company List Card -->
    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Loading Spinner -->
            <div id="loadingSpinner" class="text-center py-5" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading companies...</p>
            </div>

            <!-- Company Table Container -->
            <div id="companyTableContainer">
                @await Html.PartialAsync("_CompanyListPartial", Model)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimeout = null;

        function applyFilters() {
            // Clear existing timeout
            if (searchTimeout) {
                clearTimeout(searchTimeout);
            }

            // Set new timeout for search (300ms debounce)
            searchTimeout = setTimeout(() => {
                loadPage(1); // Reset to page 1 when filters change
            }, 300);
        }

        function loadPage(pageNumber) {
            const companyType = document.getElementById('companyTypeFilter').value;
            const searchTerm = document.getElementById('searchInput').value;
            const pageSize = document.getElementById('pageSizeFilter').value;

            // Show loading spinner
            document.getElementById('loadingSpinner').style.display = 'block';
            document.getElementById('companyTableContainer').style.opacity = '0.5';

            // Build query string
            const url = `/CompanyDet/SearchCompanies?companyType=${encodeURIComponent(companyType)}&searchTerm=${encodeURIComponent(searchTerm)}&page=${pageNumber}&pageSize=${pageSize}`;

            // Fetch data
            fetch(url)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('companyTableContainer').innerHTML = html;
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('companyTableContainer').style.opacity = '1';
                })
                .catch(error => {
                    console.error('Error loading companies:', error);
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('companyTableContainer').style.opacity = '1';
                    alert('Error loading companies. Please try again.');
                });
        }

        function clearFilters() {
            document.getElementById('companyTypeFilter').value = 'All';
            document.getElementById('searchInput').value = '';
            document.getElementById('pageSizeFilter').value = '10';
            loadPage(1);
        }

        function deleteCompany(companyId) {
            if (confirm('Are you sure you want to delete this company? This action will be logged in the audit system.')) {
                fetch(`/CompanyDet/SoftDelete/${companyId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Reload current page
                        const currentPage = parseInt(document.querySelector('.pagination .active .page-link')?.textContent || '1');
                        loadPage(currentPage);
                        showSuccessAlert('Company deleted successfully!');
                    } else {
                        // Check if it's an authorization error
                        if (data.isUnauthorized) {
                            showUnauthorizedModal(data.message, data.details);
                        } else {
                            showErrorAlert(data.message || 'Error deleting company. Please try again.');
                        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showErrorAlert('Error deleting company. Please try again.');
                });
            }
        }

        function showUnauthorizedModal(title, message) {
            // Create modal HTML
            const modalHtml = `
                <div class="modal fade" id="unauthorizedModal" tabindex="-1" aria-labelledby="unauthorizedModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-danger">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title" id="unauthorizedModalLabel">
                                    <i class="bi bi-shield-exclamation"></i> ${title}
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center py-4">
                                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                                <p class="mt-3 mb-0">${message}</p>
                                <small class="text-muted d-block mt-2">
                                    <i class="bi bi-info-circle"></i> You are logged in as: <strong>@User.Identity?.Name</strong>
                                </small>
                                <small class="text-muted d-block">
                                    Role: <strong>@(User.IsInRole("Admin") ? "Administrator" : "User")</strong>
                                </small>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle"></i> Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('unauthorizedModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to body
            document.body.insertAdjacentHTML('beforeend', modalHtml);

            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('unauthorizedModal'));
            modal.show();

            // Remove modal from DOM after it's hidden
            document.getElementById('unauthorizedModal').addEventListener('hidden.bs.modal', function () {
                this.remove();
            });
        }

        function showSuccessAlert(message) {
            const alertHtml = `
                <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3" role="alert" style="z-index: 9999;">
                    <i class="bi bi-check-circle-fill"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', alertHtml);
            
            // Auto-dismiss after 3 seconds
            setTimeout(() => {
                const alert = document.querySelector('.alert-success');
                if (alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            }, 3000);
        }

        function showErrorAlert(message) {
            const alertHtml = `
                <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3" role="alert" style="z-index: 9999;">
                    <i class="bi bi-exclamation-triangle-fill"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', alertHtml);
            
            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                const alert = document.querySelector('.alert-danger');
                if (alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            }, 5000);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Set initial values from model
            document.getElementById('companyTypeFilter').value = '@Model.CompanyType';
            document.getElementById('pageSizeFilter').value = '@Model.PageSize';
            console.log('Company Management Dashboard loaded');
        });
    </script>
}

