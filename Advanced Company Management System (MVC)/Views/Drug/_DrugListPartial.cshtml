@model BL.ViewModels.Drug.DrugFilterVM

<div class="table-responsive">
    <table class="table table-hover table-striped">
        <thead class="table-primary">
            <tr>
                <th>Trade Code</th>
                <th>Trade Name</th>
                <th>Drug Type</th>
                <th>Company (Applicant)</th>
                <th>Dosage Form</th>
                <th>Strength</th>
                <th>Registration Date</th>
                <th>Expiry Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Drugs != null && Model.Drugs.Any())
            {
                @foreach (var drug in Model.Drugs)
                {
                    <tr>
                        <td><code>@drug.TradeCode</code></td>
                        <td><strong>@drug.Trade_name</strong></td>
                        <td>
                            <span class="badge bg-@(drug.DrugTypeName == "Biological" ? "success" : "primary")">
                                @drug.DrugTypeName
                            </span>
                        </td>
                        <td>
                            @drug.Applicant
                        </td>
                        <td>@drug.Dosage_form</td>
                        <td>@drug.Strength_value @drug.StrengthUnit</td>
                        <td>@(drug.Drug_registration_date?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                        <td>
                            @if (drug.Drug_registration_expiration_date.HasValue)
                            {
                                var expiryDate = drug.Drug_registration_expiration_date.Value;
                                var daysUntilExpiry = (expiryDate - DateTime.Now).Days;
                                var badgeClass = daysUntilExpiry < 90 ? "danger" : daysUntilExpiry < 180 ? "warning" : "secondary";
                                <span class="badge bg-@badgeClass">
                                    @expiryDate.ToString("yyyy-MM-dd")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@(drug.regstatus == "Registered" ? "success" : "warning")">
                                @drug.regstatus
                            </span>
                            @if (!string.IsNullOrEmpty(drug.LicStatus))
                            {
                                <br /><small class="text-muted">@drug.LicStatus</small>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        <h5>No drugs found matching your criteria</h5>
                        <p class="mb-0">Try adjusting your search term or filter</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Server-Side Pagination Controls -->
<nav aria-label="Drug pagination" class="mt-3">
    <div class="row align-items-center">
        <div class="col-md-6">
            <p class="text-muted mb-0">
                <i class="bi bi-info-circle"></i>
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords)) 
                of <strong>@Model.TotalRecords</strong> drugs
                <small class="text-muted">(Page @Model.PageNumber of @Model.TotalPages)</small>
            </p>
            <small class="text-muted">
                <i class="bi bi-database-check"></i> Server-side pagination - Only @Model.PageSize records fetched from database
            </small>
        </div>
        <div class="col-md-6">
            <ul class="pagination justify-content-end mb-0">
                <!-- Previous Button -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(Model.PageNumber - 1)); return false;">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                </li>

                <!-- Page Numbers -->
                @{
                    int startPage = Math.Max(1, Model.PageNumber - 2);
                    int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="#" onclick="loadPage(1); return false;">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="#" onclick="loadPage(@i); return false;">@i</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="#" onclick="loadPage(@Model.TotalPages); return false;">@Model.TotalPages</a>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(Model.PageNumber + 1)); return false;">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Technical Info -->
<div class="alert alert-light border mt-3">
    <small class="text-muted">
        <strong>Data Source:</strong> GetDrugsData database view | 
        <strong>Filter:</strong> DrugTypeName = "@Model.DrugType" | 
        <strong>Search:</strong> @(string.IsNullOrEmpty(Model.SearchTerm) ? "None" : Model.SearchTerm) |
        <strong>Records/Page:</strong> @Model.PageSize
    </small>
</div>

