@using BL.ViewModels.CompanyAuditLog
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model CompanyAuditLogReadVM


<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Log Action Details</h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Company Id</div>
                <div class="col-md-8">@Model.CompanyId</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Operation Type</div>
                <div class="col-md-8">
                    @if (Model.OperationType == "Delete")
                    {
                        <span class="badge bg-danger">Delete</span>
                    }
                    else if (Model.OperationType == "Update")
                    {
                        <span class="badge bg-warning text-dark">Update</span>
                    }
                    else if (Model.OperationType == "Insert")
                    {
                        <span class="badge bg-success">Insert</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.OperationType</span>
                    }
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Performed By</div>
                <div class="col-md-8">@Model.PerformedBy</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Performed Date</div>
                <div class="col-md-8">@Model.PerformedDate</div>
            </div>

            <div class="text-end">
                <a href="/CompanyAuditLog/GetAll" class="btn btn-outline-primary">
                    Back
                </a>
            </div>

        </div>
    </div>

</div>
